# ──────────────────────────────────────────────────────────────────
# Copy to .env.local for local dev. On Vercel, add these under
# Project → Settings → Environment Variables. NEVER commit real values.
# ──────────────────────────────────────────────────────────────────

# Absolute site URL (must match the OAuth redirect URIs registered
# with Meta/TikTok). Production:
SITE_URL=https://bellarawlings.com

# ── Admin (/admin) ────────────────────────────────────────────────
# Any long random string (e.g. `openssl rand -hex 32`). Signs sessions,
# magic links, and email-confirmation tokens.
ADMIN_SESSION_SECRET=
# Guardian/manager email — gets the magic sign-in links.
ADMIN_EMAIL=
# Optional password fallback (useful for local dev without email).
ADMIN_PASSWORD=

# ── Email (Resend: resend.com, free tier) ─────────────────────────
# Used for: booking inquiries, mailing-list double opt-in, magic links.
RESEND_API_KEY=
# Audience id from Resend → Audiences (the mailing list).
RESEND_AUDIENCE_ID=
# A sender on your verified domain in Resend.
CONTACT_FROM_EMAIL=hello@bellarawlings.com

# ── Token storage (Tier 2 social feeds) ───────────────────────────
# Add the Vercel "Upstash for Redis" (or any Redis REST) integration;
# it sets these automatically. Required in production for OAuth tokens.
KV_REST_API_URL=
KV_REST_API_TOKEN=

# ── Instagram (Instagram API with Instagram Login) ────────────────
# From your Meta developer app (reusable across artist clients).
INSTAGRAM_CLIENT_ID=
INSTAGRAM_CLIENT_SECRET=

# ── TikTok (Display API: user.info.basic, video.list) ─────────────
# From your TikTok for Developers app.
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=

# ── Cron protection ───────────────────────────────────────────────
# Any random string; Vercel sends it as a Bearer token to cron routes.
CRON_SECRET=

# ── Optional: seed tokens via env instead of KV (simple mode) ──────
# INSTAGRAM_ACCESS_TOKEN=
# TIKTOK_ACCESS_TOKEN=
# TIKTOK_REFRESH_TOKEN=
